// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "terminal": {
    "font_family": "Hack Nerd Font"
  },
  "proxy": "",
  "disable_ai": true,
  "diff_view_style": "split",
  "outline_panel": {
    "folder_icons": true,
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  // Zed
  "base_keymap": "JetBrains",
  "auto_update": false,
  "mouse_wheel_zoom": false,
  // Font
  "ui_font_family": ".ZedMono",
  "ui_font_size": 17,
  "buffer_font_family": ".ZedMono",
  "buffer_font_size": 15,
  "buffer_line_height": {
    "custom": 2,
  },
  // Editor
  "extend_comment_on_newline": false,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "cursor_blink": false,
  "selection_highlight": false,
  "seed_search_query_from_cursor": "selection",
  "inline_code_actions": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,
  "when_closing_with_no_tabs": "keep_window_open",
  "close_on_file_delete": true,
  "restore_on_startup": "empty_tab",
  "session": {
    "trust_all_worktrees": true,
    "restore_unsaved_buffers": false,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  // "restore_on_file_reopen": false,
  // Themes
  "icon_theme": {
    "mode": "system",
    "light": "Base Charmed Icons",
    "dark": "Base Charmed Icons",
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro",
  },
  "theme_overrides": {
    "One Dark Pro": {
      "editor.document_highlight.read_background": "#00000000",
      "editor.document_highlight.write_background": "#00000000",
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
    "One Light": {
      "editor.document_highlight.read_background": "#00000000",
      "editor.document_highlight.write_background": "#00000000",
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  // Panels
  "project_panel": {
    "sort_order": "lower",
    "bold_folder_labels": false,
    "dock": "left",
    "hide_root": true,
    "auto_fold_dirs": false,
    "indent_guides": {
      "show": "never",
    },
    "sticky_scroll": false,
  },
  "title_bar": {
    "show_project_items": true,
  },
  "gutter": {
    "min_line_number_digits": 0,
  },
  "indent_guides": {
    "enabled": false,
  },
}
